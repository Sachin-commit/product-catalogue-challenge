# Copy to backend/.env to override defaults. Every value here is optional for local use:
# the API runs with no .env at all. docker compose also reads this file if it exists.
# Never commit backend/.env.

# --- Server ---
PORT=8080
LOG_LEVEL=info
# true when running behind a load balancer (e.g. AWS ALB), so rate limiting sees client IPs
TRUST_PROXY=false

# --- Product data source ---
# fakestore-api       live https://fakestoreapi.com (needs internet)
# fakestore-snapshot  recorded copy in data/, for offline use
PRODUCT_SOURCE=fakestore-api
FAKESTORE_BASE_URL=https://fakestoreapi.com
FAKESTORE_SNAPSHOT_FILE=data/fakestore-products.snapshot.json
UPSTREAM_TIMEOUT_MS=5000
CATALOGUE_CACHE_TTL_SECONDS=300

# --- Merchandising (the owner's "top rated" picks) ---
MERCHANDISING_FILE=data/merchandising.json

# --- Email ---
# smtp  send via SMTP (Mailpit locally; AWS SES SMTP endpoint in production)
# log   write emails to the log instead of sending (no mail server needed)
EMAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Leave blank for Mailpit. For SES, use SMTP credentials from AWS (store them in Secrets Manager, not here).
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Product Catalogue <no-reply@catalogue.local>
SALES_INBOX=sales@catalogue.local

# --- Abuse protection ---
ENQUIRY_RATE_LIMIT_MAX=10
ENQUIRY_RATE_LIMIT_WINDOW_MINUTES=15
